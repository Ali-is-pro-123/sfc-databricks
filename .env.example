# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=UTC

# PostgreSQL
POSTGRES_DB=dineiq
POSTGRES_USER=dineiq
POSTGRES_PASSWORD=replace-this-with-a-random-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dineiq:replace-this-with-a-random-db-password@127.0.0.1:5432/dineiq

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Apache Spark
SPARK_MASTER_PORT=17077
SPARK_MASTER_UI_PORT=18080
SPARK_WORKER_UI_PORT=18081
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_MASTER_URL=spark://127.0.0.1:17077
